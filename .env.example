# Copy to .env.local for local testing (optional), and add the same variables in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The secret / service_role key. Server-side only — never put it in public/ files.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Any long random text (e.g. 40+ characters). Used to turn IP addresses into a
# one-way code. Keep it secret and never change it during data collection,
# otherwise the same connection gets a different code.
IP_HASH_SALT=change-me-to-a-long-random-string

# Optional: Cloudflare Turnstile bot check. Put the SITE key in
# public/questions.js (STUDY_INFO.turnstileSiteKey) and the SECRET key here.
TURNSTILE_SECRET_KEY=

# Optional: private text that unlocks the detailed /api/health view (send it as the x-health-token header).
HEALTH_TOKEN=
