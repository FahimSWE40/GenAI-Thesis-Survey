# Copy to .env.local for local testing with Supabase (optional),
# and add the same two variables in Vercel → Project → Settings → Environment Variables.
# Supabase → Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The service_role / secret key. Server-side only — never put it in public/ files.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
